  "fonctions": [
    {
      "id": "steps",
      "nom": "Pas et longueur",
      "description": "Un motif se compose de blocs de 16 pas. LENGTH (1-4) fixe le nombre de blocs : jusqu'à 4 × 16 = 64 pas. Les boutons Step 1-4 montrent et choisissent le bloc édité. En pas à pas, les pads allument / éteignent chaque pas ; une note C4 est posée par défaut.",
      "sources": [
        {
          "doc": "OM",
          "page": 24
        },
        {
          "doc": "OM",
          "page": 30
        },
        {
          "doc": "OM",
          "page": 32
        },
        {
          "doc": "PG",
          "page": 3
        },
        {
          "doc": "PG",
          "page": 5
        }
      ],
      "synth": "confirmé",
      "parametres": [
        "pat.length",
        "step.number"
      ],
      "schema": {
        "blocs": 4,
        "pasParBloc": 16,
        "maxPas": 64,
        "notation": "bloc.pas (1.01 … 4.16)"
      }
    },
    {
      "id": "laststep",
      "nom": "Last Step",
      "description": "Raccourcit une partie (1-16 pas) pour des mesures impaires et des décalages entre parties.",
      "sources": [
        {
          "doc": "PG",
          "page": 4
        }
      ],
      "synth": "confirmé",
      "parametres": [
        "part.laststep"
      ]
    },
    {
      "id": "beat",
      "nom": "Beat",
      "description": "Résolution : 16, 32, 8Tri ou 16Tri (triolets : 12 pas par bloc).",
      "sources": [
        {
          "doc": "OM",
          "page": 32
        },
        {
          "doc": "PG",
          "page": 3
        }
      ],
      "synth": "confirmé",
      "parametres": [
        "pat.beat"
      ]
    },
    {
      "id": "stepedit",
      "nom": "Step Edit",
      "description": "Édition détaillée de chaque pas : note (4 max), gate time, vélocité, valeur de motion.",
      "sources": [
        {
          "doc": "OM",
          "page": 30
        },
        {
          "doc": "PG",
          "page": 5
        }
      ],
      "synth": "confirmé",
      "parametres": [
        "step.number",
        "step.note",
        "step.gate",
        "step.velocity"
      ]
    },
    {
      "id": "realtime",
      "nom": "Enregistrement en temps réel",
      "description": "Enregistre ce que tu joues sur les pads ou le pad tactile sans arrêter la lecture ; le métronome peut aider.",
      "sources": [
        {
          "doc": "OM",
          "page": 30
        }
      ],
      "synth": "confirmé",
      "parametres": [
        "glob.metronome"
      ]
    },
    {
      "id": "motionseq",
      "nom": "Motion Sequence",
      "description": "Enregistre les mouvements de potards / boutons d'une partie sur un cycle de motif. Modes Smooth ou Trigger Hold. Contrôles enregistrables : OSC Edit, Pitch, Cutoff, Resonance, EG Int, Speed, Depth, Level, Pan, Attack, Decay/Release, IFX Edit, IFX On, MFX Send, Master Fx On/X/Y.",
      "sources": [
        {
          "doc": "OM",
          "page": 30
        },
        {
          "doc": "OM",
          "page": 31
        },
        {
          "doc": "PG",
          "page": 4
        }
      ],
      "synth": "confirmé",
      "parametres": [
        "part.motionseq",
        "pat.clearmfxmotion"
      ]
    },
    {
      "id": "stepjump",
      "nom": "Step Jump",
      "description": "Pendant la lecture, un pad saute directement au pas 1-16. Plusieurs pads tenus = pas joués dans l'ordre d'appui. Avec Last Step ou en triolets, les pads au-delà enchaînent sur la mesure suivante.",
      "sources": [
        {
          "doc": "OM",
          "page": 24
        },
        {
          "doc": "PG",
          "page": 3
        },
        {
          "doc": "PG",
          "page": 4
        }
      ],
      "synth": "confirmé"
    },
    {
      "id": "keyboard",
      "nom": "Mode Keyboard",
      "description": "Les pads deviennent un clavier dans la gamme KEY/SCALE. Step 1 = octave en dessous, Step 4 = octave au-dessus.",
      "sources": [
        {
          "doc": "OM",
          "page": 28
        }
      ],
      "synth": "confirmé",
      "parametres": [
